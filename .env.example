# --- IA (obligatoire pour l'IA générative ; sans clé, la démo passe en mode simulé) ---
ANTHROPIC_API_KEY=
# Modèle de l'agent vocal (défaut : claude-opus-5-5) et de l'analyse d'onboarding
OSSIAN_AGENT_MODEL=
OSSIAN_ONBOARDING_MODEL=

# --- Voix premium pour la démo navigateur (optionnel) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Téléphonie Vapi (voir docs/VAPI.md) ---
# Secret partagé entre Vercel et Vapi (en-tête x-ossian-key). Obligatoire en production.
OSSIAN_VOICE_SECRET=
# Webhook qui reçoit demandes de RDV, leads, rappels, comptes-rendus (Slack, Teams, Make, Zapier…)
OSSIAN_NOTIFY_WEBHOOK_URL=
# Mémoire d'appel partagée (Vercel Marketplace → Upstash Redis ; KV_REST_API_* aussi accepté)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Utilisés uniquement par le script local `npm run vapi`
VAPI_API_KEY=
VAPI_API_BASE=https://api.eu.vapi.ai
OSSIAN_BASE_URL=https://ossian-ai.vercel.app

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données (production, non utilisé par la démo) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
